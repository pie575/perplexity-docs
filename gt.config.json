{
  "options": {
    "experimentalClearLocaleDirs": true,
    "mintlify": {
      "inferTitleFromFilename": true,
      "openapi": {
        "files": [
          "./openapi/openapi-auth.json",
          "./openapi/openapi-gateway-chat.json",
          "./openapi/openapi-gateway-messages.json",
          "./openapi/openapi-gateway-responses.json",
          "./openapi/openapi.json"
        ]
      }
    },
    "jsonSchema": {
      "./docs.json": {
        "preset": "mintlify-hide-default"
      },
      "./openapi/openapi-auth.json": {
        "preset": "openapi"
      },
      "./openapi/openapi-gateway-chat.json": {
        "preset": "openapi"
      },
      "./openapi/openapi-gateway-messages.json": {
        "preset": "openapi"
      },
      "./openapi/openapi-gateway-responses.json": {
        "preset": "openapi"
      },
      "./openapi/openapi.json": {
        "preset": "openapi"
      }
    },
    "docsUrlPattern": "/[locale]",
    "docsImportPattern": "/snippets/[locale]",
    "generateRedirects": "./docs.json",
    "experimentalLocalizeStaticImports": true,
    "experimentalLocalizeStaticUrls": true,
    "experimentalLocalizeRelativeAssets": true,
    "docsHideDefaultLocaleImport": true,
    "experimentalHideDefaultLocale": true,
    "experimentalAddHeaderAnchorIds": "mintlify"
  },
  "files": {
    "json": {
      "include": [
        "./openapi/openapi-auth.json",
        "./openapi/openapi-gateway-chat.json",
        "./openapi/openapi-gateway-messages.json",
        "./openapi/openapi-gateway-responses.json",
        "./openapi/openapi.json",
        "./docs.json"
      ],
      "transform": [
        {
          "match": "^openapi/openapi-auth.json$",
          "replace": "{locale}/openapi/openapi-auth.json"
        },
        {
          "match": "^openapi/openapi-gateway-chat.json$",
          "replace": "{locale}/openapi/openapi-gateway-chat.json"
        },
        {
          "match": "^openapi/openapi-gateway-messages.json$",
          "replace": "{locale}/openapi/openapi-gateway-messages.json"
        },
        {
          "match": "^openapi/openapi-gateway-responses.json$",
          "replace": "{locale}/openapi/openapi-gateway-responses.json"
        },
        {
          "match": "^openapi/openapi.json$",
          "replace": "{locale}/openapi/openapi.json"
        }
      ]
    },
    "mdx": {
      "include": [
        "./**/*.mdx",
        "./**/*.md"
      ],
      "transform": {
        "match": "^(snippets/)?(.*)$",
        "replace": "$1{locale}/$2"
      },
      "exclude": [
        "./[locales]/**/*.mdx",
        "./snippets/[locales]/**/*.mdx",
        "./[locales]/**/*.md",
        "./snippets/[locales]/**/*.md",
        "./**/README.md",
        "./**/LICENSE.md",
        "./**/COPYING.md",
        "./**/NOTICE.md",
        "./**/CHANGELOG.md",
        "./**/HISTORY.md",
        "./**/CODE_OF_CONDUCT.md",
        "./**/CONTRIBUTING.md",
        "./**/SECURITY.md",
        "./**/GOVERNANCE.md",
        "./**/AGENTS.md",
        "./**/OWNERS.md",
        "./**/MAINTAINERS.md"
      ]
    }
  },
  "locales": [
    "es",
    "ja",
    "zh",
    "fr"
  ],
  "defaultLocale": "en",
  "$schema": "https://assets.gtx.dev/config-schema.json"
}