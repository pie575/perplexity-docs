  "info": {
    "description": "Acceso compatible con Anthropic Messages a modelos de distintos proveedores.",
    "title": "Perplexity Router API (Anthropic-compatible)",
    "version": "0.5.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/router/v1/messages": {
      "post": {
        "description": "Envía una conversación a cualquier modelo de Router mediante el esquema Anthropic Messages. Establece `stream: true` para recibir eventos enviados por el servidor. Autentícate con tu clave de API de Perplexity API; se aceptan tanto `Authorization: Bearer` como el encabezado `x-api-key` predeterminado del SDK de Anthropic.",
        "operationId": "gateway_create_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            },
            "description": "Respuesta correcta. JSON para solicitudes sin streaming; un `text/event-stream` de eventos tipados (desde `message_start` hasta `message_stop`) cuando `stream` es true."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Solicitud no válida: cuerpo malformado, parámetro no compatible o modelo no disponible en Router."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Se superó el límite de solicitudes o el modelo subyacente está sobrecargado. Vuelve a intentarlo después del intervalo `Retry-After`."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Crear mensaje"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.perplexity.ai"
    }
  ]
}