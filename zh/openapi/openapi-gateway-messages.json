              {
                "title": "Text",
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/TextBlock"
                },
                "title": "Text blocks",
                "type": "array"
              }
            ]
          },
          "temperature": {
            "format": "float",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "thinking": {
            "$ref": "#/components/schemas/ThinkingConfig"
          },
          "tool_choice": {
            "$ref": "#/components/schemas/ToolChoice"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/Tool"
            },
            "type": "array"
