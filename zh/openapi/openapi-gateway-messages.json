            "x-go-type": "json.RawMessage"
          },
          "inference_geo": {
            "description": "验证拒绝——无法满足地理位置固定要求；静默忽略会违背数据驻留预期。",
            "type": "string"
          },
          "max_tokens": {
            "description": "要生成的最大 token 数。Messages API 必填。",
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "mcp_servers": {
            "description": "验证拒绝——不支持服务器端 MCP 执行。",
            "x-go-type": "json.RawMessage"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/InputMessage"
            },
            "type": "array"
          },
          "metadata": {
            "$ref": "#/components/schemas/RequestMetadata"
          },
          "model": {
            "description": "公开模型 slug，例如 `perplexity/kimi-k3`。",
            "type": "string"
          },
          "output_config": {
            "$ref": "#/components/schemas/OutputConfig"
          },
          "service_tier": {
            "description": "接受但忽略——llm-api 的 service_tier 仅适用于 OpenAI。",
            "enum": [
              "auto",
              "standard_only"
            ],
            "type": "string"
          },
          "speed": {
            "description": "\"standard\" 无效；\"fast\" 被拒绝（不支持快速模式路由）。",
            "enum": [
              "standard",
              "fast"
            ],
            "type": "string"
          },
