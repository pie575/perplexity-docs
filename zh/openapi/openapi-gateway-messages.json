  "info": {
    "description": "通过兼容 Anthropic Messages 的接口访问不同提供商的模型。",
    "title": "Perplexity Router API (Anthropic-compatible)",
    "version": "0.5.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/router/v1/messages": {
      "post": {
        "description": "使用 Anthropic Messages 架构向任意 Router 模型发送对话。设置 `stream: true` 以接收服务器发送事件。使用您的 Perplexity API 密钥进行身份验证——支持 `Authorization: Bearer` 和 Anthropic SDK 默认的 `x-api-key` 请求头。",
        "operationId": "gateway_create_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            },
            "description": "成功响应。非流式请求返回 JSON；当 `stream` 为 true 时，返回包含类型化事件（从 `message_start` 到 `message_stop`）的 `text/event-stream`。"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "无效请求——请求正文格式错误、参数不受支持，或 Router 上没有可用的模型。"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "超出速率限制，或上游模型过载。请在 `Retry-After` 指定的间隔后重试。"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "创建消息"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.perplexity.ai"
    }
  ]
}