  "info": {
    "description": "Accès aux modèles de différents fournisseurs, compatible avec Anthropic Messages.",
    "title": "Perplexity Router API (Anthropic-compatible)",
    "version": "0.5.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/router/v1/messages": {
      "post": {
        "description": "Envoyez une conversation à n’importe quel modèle Router à l’aide du schéma Anthropic Messages. Définissez `stream: true` pour recevoir des événements envoyés par le serveur. Authentifiez-vous avec votre clé API Perplexity : l’en-tête `Authorization: Bearer` comme l’en-tête `x-api-key` par défaut du SDK Anthropic sont acceptés.",
        "operationId": "gateway_create_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            },
            "description": "Réponse réussie. JSON pour les requêtes sans streaming ; flux `text/event-stream` d’événements typés (de `message_start` à `message_stop`) lorsque `stream` est défini sur true."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Requête non valide — corps malformé, paramètre non pris en charge ou modèle indisponible sur le Router."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Limite de débit dépassée ou modèle en amont surchargé. Réessayez après l’intervalle indiqué par `Retry-After`."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Créer un message"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.perplexity.ai"
    }
  ]
}