              "medium",
              "high",
              "xhigh",
              "max"
            ]
          },
          "task_budget": {
            "description": "Accepted and ignored \u2014 llm-api has no task-budget carrier.",
            "x-go-type": "json.RawMessage"
          }
        }
      },
      "OutputConfigFormat": {
        "type": "object",
        "properties": {
