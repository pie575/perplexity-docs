            "description": "Rejected by validation \u2014 llm-api's count carrier does not forward it yet."
          },
          "thinking": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ThinkingConfig"
              }
            ],
            "description": "Rejected by validation \u2014 llm-api's count carrier does not forward it yet."
          }
        },
        "required": [
          "model",
          "messages"
        ]
      },
      "CountMessageTokensResponse": {
        "type": "object",
        "description": "Response body for POST /router/v1/messages/count_tokens.",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Tokens the prompt would consume as /messages input."
          }
        },
        "required": [
          "input_tokens"
        ]
      },
      "CacheControl": {
        "type": "object",
        "description": "Ephemeral cache breakpoint. ttl \"1h\" is rejected until 1h writes are billed distinctly (they price 2x the 5m rate).",
        "properties": {
          "type": {
            "type": "string",
